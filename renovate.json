{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": ["renovate", "dependencies"],
  "automergeType": "pr",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}.x",

  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/\\.yaml$/",
      "/\\.yml$/"
    ]
  },

  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "groupName": "core-infrastructure",
      "matchPackageNames": [
        "/tailscale/",
        "/cilium/",
        "/traefik/",
        "/cert-manager/"
      ]
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "docker-image-updates"
    },
    {
      "matchDatasources": ["helm"],
      "groupName": "helm-chart-updates"
    },
    {
      "matchManagers": ["flux"],
      "groupName": "flux-helm-releases"
    }
  ]
}
